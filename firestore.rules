rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo el dueño puede leer/editar sus propios datos de usuario
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Los formularios solo los lee/edita su dueño.
    // La ESCRITURA de nuevos envíos (submissions) la hace SIEMPRE la Cloud Function
    // con permisos de admin, nunca el cliente directamente — por eso aquí
    // "create" en submissions está bloqueado para clientes normales.
    match /forms/{formId} {
      allow read, update, delete: if request.auth != null
                                    && request.auth.uid == resource.data.ownerUid;
      allow create: if request.auth != null
                     && request.auth.uid == request.resource.data.ownerUid;

      match /submissions/{submissionId} {
        // El dueño del formulario puede leer y marcar como leído sus envíos
        allow read, update: if request.auth != null
                              && request.auth.uid == get(/databases/$(database)/documents/forms/$(formId)).data.ownerUid;
        // Nadie escribe submissions directamente desde el cliente:
        // solo la Cloud Function (Admin SDK) puede crearlas.
        allow create, delete: if false;
      }
    }
  }
}
